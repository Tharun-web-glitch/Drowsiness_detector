from google.colab import files
uploaded = files.upload()


import cv2
import mediapipe as mp
import numpy as np
from IPython.display import HTML
from base64 import b64encode
from mediapipe.tasks import python
from mediapipe.tasks.python import vision

# -----------------------------
# 1. Configuration & Thresholds
# -----------------------------
video_path = '1.mp4'                # Uploading our file
EAR_THRESHOLD = 0.22                # Typical threshold for "closed" eyes
CLOSED_FRAMES_WAIT = 15             # Alert triggers after ~0.75 seconds (at 20fps)

# Indices for EAR calculation (MediaPipe Landmarker)
# These are ordered: [P1, P2, P3, P4, P5, P6]
L_EYE_IDX = [33, 160, 158, 133, 153, 144]
R_EYE_IDX = [362, 385, 387, 263, 373, 380]

def calculate_ear(landmarks, indices, w, h):
    # Extract points and scale to pixel coordinates
    pts = []
    for idx in indices:
        lm = landmarks[idx]
        pts.append(np.array([lm.x * w, lm.y * h]))

    # EAR formula: (|p2-p6| + |p3-p5|) / (2 * |p1-p4|)
    vertical_1 = np.linalg.norm(pts[1] - pts[5])
    vertical_2 = np.linalg.norm(pts[2] - pts[4])
    horizontal = np.linalg.norm(pts[0] - pts[3])

    return (vertical_1 + vertical_2) / (2.0 * horizontal)

# -----------------------------
# 2. Setup AI Detector
# -----------------------------
base_options = python.BaseOptions(model_asset_path="face_landmarker.task")
options = vision.FaceLandmarkerOptions(
    base_options=base_options,
    output_face_blendshapes=False,
    num_faces=1                           # Helps to detect onlyone face at once
)
detector = vision.FaceLandmarker.create_from_options(options)

# -----------------------------
# 3. Process Video
# -----------------------------
cap = cv2.VideoCapture(video_path)
width  = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
fps    = 20.0

fourcc = cv2.VideoWriter_fourcc(*'mp4v')
out = cv2.VideoWriter('drowsiness_output.mp4', fourcc, fps, (width, height))

frame_counter = 0

while cap.isOpened():
    ret, frame = cap.read()
    if not ret: break

    # Convert for AI processing
    rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb_frame)
    result = detector.detect(mp_image)

    if result.face_landmarks:
        face = result.face_landmarks[0]

        # Calculate EAR for both eyes
        ear_l = calculate_ear(face, L_EYE_IDX, width, height)
        ear_r = calculate_ear(face, R_EYE_IDX, width, height)
        avg_ear = (ear_l + ear_r) / 2.0

        # Drowsiness Logic
        if avg_ear < EAR_THRESHOLD:
            frame_counter += 1
        else:
            frame_counter = 0 # Reset if eyes open

        # Visual Feedback: Draw the eye contours (Green if awake, Red if drowsy)
        color = (0, 255, 0) if frame_counter < CLOSED_FRAMES_WAIT else (0, 0, 255)

        for eye_pts in [L_EYE_IDX, R_EYE_IDX]:
            pts = np.array([[int(face[i].x * width), int(face[i].y * height)] for i in eye_pts])
            cv2.polylines(frame, [pts], True, color, 2)

        # Alert Overlay
        if frame_counter >= CLOSED_FRAMES_WAIT:
            cv2.putText(frame, "!!! DROWSINESS ALERT !!!", (50, 280),
                        cv2.FONT_HERSHEY_SIMPLEX, 1.2, (0, 0, 255), 3)

        # Display EAR value for debugging
        cv2.putText(frame, f"EAR: {avg_ear:.2f}", (50, height - 50),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)

    out.write(frame)

cap.release()
out.release()



